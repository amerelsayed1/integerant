# Laravel app
APP_NAME=Integrant
APP_ENV=production
APP_KEY=base64:CHANGE_ME_RUN_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://integerant.com

# Database (used by both app and db service)
DB_CONNECTION=pgsql
DB_HOST=integrant-db
DB_PORT=5432
DB_DATABASE=integrant
DB_USERNAME=integrant
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

POSTGRES_DB=integrant
POSTGRES_USER=integrant
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Sessions / cache / queue (no Redis needed for this app)
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Proxy (required — nginx sits in front)
TRUSTED_PROXIES=*

LOG_CHANNEL=stack
LOG_LEVEL=error
